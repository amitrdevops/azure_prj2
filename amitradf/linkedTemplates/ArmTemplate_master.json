{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "amitradf"
		},
		"ls_cust_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_cust'"
		},
		"ls_t_customer_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_t_customer'"
		},
		"ls_t_txn_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_t_txn'"
		},
		"ls_txn_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_txn'"
		},
		"ls_t_customer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "amitrsqlsrvr.database.windows.net"
		},
		"ls_t_customer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db01"
		},
		"ls_t_customer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "amitrazureuser"
		},
		"ls_t_txn_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "amitrsqlsrvr.database.windows.net"
		},
		"ls_t_txn_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db01"
		},
		"ls_t_txn_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "amitrazureuser"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "amitradf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_cust_connectionString": {
						"value": "[parameters('ls_cust_connectionString')]"
					},
					"ls_t_customer_password": {
						"value": "[parameters('ls_t_customer_password')]"
					},
					"ls_t_txn_password": {
						"value": "[parameters('ls_t_txn_password')]"
					},
					"ls_txn_connectionString": {
						"value": "[parameters('ls_txn_connectionString')]"
					},
					"ls_t_customer_properties_typeProperties_server": {
						"value": "[parameters('ls_t_customer_properties_typeProperties_server')]"
					},
					"ls_t_customer_properties_typeProperties_database": {
						"value": "[parameters('ls_t_customer_properties_typeProperties_database')]"
					},
					"ls_t_customer_properties_typeProperties_userName": {
						"value": "[parameters('ls_t_customer_properties_typeProperties_userName')]"
					},
					"ls_t_txn_properties_typeProperties_server": {
						"value": "[parameters('ls_t_txn_properties_typeProperties_server')]"
					},
					"ls_t_txn_properties_typeProperties_database": {
						"value": "[parameters('ls_t_txn_properties_typeProperties_database')]"
					},
					"ls_t_txn_properties_typeProperties_userName": {
						"value": "[parameters('ls_t_txn_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}